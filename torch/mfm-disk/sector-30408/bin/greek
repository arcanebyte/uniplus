
# %Z%ROOT      %M%     %I%
# %Z%iAPX286   %M%     1.1
# %Z%Unisoft   %M%     1.2
# %Z%AT&T      %M%     1.3

#	@(#)greek.sh	UniPlus V.2.1.2	(ATT 1.3)
# iAPX286 @(#)greek.sh	1.1
#	GREEKSID (@(#)greek.sh	1.7)
TERM=${1--T$TERM}
case $TERM in
-T450|-T450-12|-T1620|-T1620-12)	exec 450;;
-T300)	exec 300;;
-T300-12)	exec 300 +12;;
-T300s)	exec 300s;;
-T300s-12)	exec 300s +12;;
-Thp|-T2621|-T2645|-T2640)	exec hp;;
-T4014|-Ttek)	exec 4014;;
"")	echo 'usage: greek [ -Tterminal ]  ($TERM must be set if arg omitted)' >&2
	exit 1;;
*)	echo "greek: $TERM not implemented" >&2;	exit 1;;
esac
