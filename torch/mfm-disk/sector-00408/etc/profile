umask 22
stty intr '^c' erase '^?' kill '^x'
eval `tset -sQ` 
if [ $?  != 0 ]
then  
	echo "Please set your own terminal type"
fi
TZ=GMT0BST
MAIL=/usr/mail/$LOGNAME
readonly LOGNAME
PATH=:/usr/xbin:/usr/bin/opentop:$PATH:/bin/hosts
export PATH TERM TZ MAIL LOGNAME SHELL TERMCAP PS1
