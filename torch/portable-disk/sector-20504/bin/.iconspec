icon: type=e; fn=man; showbits=utilities:manuals; showname=Manual; +
      laction=n,$0 -y man; daction=n,$0 -y `basename $1`; 

icon: type=e; fn=lp; showbits=utilities:fprint; showname=Print; +
      laction=b,lpstat; raction=b,lpstat -t; daction=b,lp -dprinter $*;

icon: type=e; fn=wdump; showbits=utilities:wprint; showname=Window; +
	laction=b,wdump|lp -dprinter -o-ecand; +
	raction=b,lpstat;

icon: type=e; fn=sd; showbits=utilities:sprint; showname=Screen; +
	laction=b,sd|lp -dprinter -o-ecand; raction=b,lpstat;

