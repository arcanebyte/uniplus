#	@(#)bcheckrc.sh	1.3
#	Torch Version 1.10	nmimode 1 before fsck

# ***** This file has those commands necessary to check the file
# system, date, and anything else that should be done before mounting
# the file systems.

trap "" 2

TZ=GMT0BST
export TZ

# Get date
getbbtime -s  </dev/null 1>/dev/null 2>&1
if [ -f /etc/dofsck ]
then
	(
	while :
	do
		yawn "File System Check" "UNIX was not shut down properly after it was last used. Do you want to check the file systems ?"
		case $? in
			 0 )
				;;
	
			 1 )
				break
				;;
	
			* )
				continue
				;;
		esac
		trap "echo Interrupt" 2
		nmimode 1
		/etc/fsck
		trap "" 2
		break
	done) >/dev/console </dev/console 2>&1
fi
# initialise file system check file 
>/etc/dofsck
# set nmi mode to enable soft powerdown
/etc/nmimode 2
