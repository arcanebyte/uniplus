#		stty $BAUD < $DEVICE
#		/usr/lib/lpsched 5< $DEVICE
#		echo lp scheduler started
#	)&
	if [ ! -f /etc/wtmp ]
	then
		>/etc/wtmp
		chmod 644 /etc/wtmp
		chgrp adm /etc/wtmp
		chown adm /etc/wtmp
	fi
	#/bin/su - adm -c /usr/lib/acct/startup
	#echo process accounting started
	if echo $PS|fgrep 'errdemon' >/dev/null
	then
		true
	else
		/usr/lib/errdemon >/dev/null 2>&1&
		echo errdemon started
	fi
