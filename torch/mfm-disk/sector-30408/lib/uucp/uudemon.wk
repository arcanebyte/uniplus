#	@(#)uudemon.wk	UniPlus V.2.1.2	(UniSoft 1.3)
# 'perform once per week, Sunday at 0530 hours'
LOGNAME=uucp
export LOGNAME
PATH=:/usr/lib/uucp:/bin:/usr/bin
cd /usr/spool/uucp
rm -f o.Log-WEEK* o.SYSLOG*
mv Log-WEEK o.Log-WEEK
(date; echo =============================) >> o.Log-WEEK
mv SYSLOG o.SYSLOG
>> SYSLOG
pack o.Log-WEEK o.SYSLOG
