chown bin /bin/ps
chgrp sys /bin/ps
chown root /bin/pstat
chgrp root /bin/pstat
chmod 2755 /bin/ps 
chmod 755 /bin/pstat

mv /unix /unix.old

echo "*** Changing from current kernel to new kernel"
mv /unix2.n /unix

echo "*** Old kernel left in /unix.old"

echo "*** You will need to reboot the system to use the new kernel."

echo "*** End of special installation"
