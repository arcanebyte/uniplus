TZ=GMT0BST
export TZ

set `who -r`
if [ $7 = 1 ]
then
	# need to do a umount -a to remove any mount entries
	# we may have left on a server if we went down without umounting
	/etc/umount -a

	# place / in mount table
	/etc/mount -fv `/etc/devnm /`

	# put mounts here (/usr, etc.)
	/etc/mount -atv 5.2			# 5.2 systems only

	/usr/lib/ex3.9preserve -
	rm -f /tmp/*
	rm -f /usr/spool/uucp/LCK*
	rm -f /usr/adm/acct/nite/lock*
	if [ -f /usr/adm/sulog ]
	then mv /usr/adm/sulog /usr/adm/OLDsulog
	fi
	if [ -f /usr/lib/cron/log ]
	then mv /usr/lib/cron/log /usr/lib/cron/OLDlog
	fi
	PS=`ps -e`
