#	@(#)bcheckrc.sh	1.3
#	Torch Version 1.10	nmimode 1 before fsck

# ***** This file has those commands necessary to check the file
# system, date, and anything else that should be done before mounting
# the file systems.
# Version 1.10 contains better version of dofsck system

trap "" 2

TZ=GMT0BST
export TZ


# Get date
getbbtime -s  </dev/null 1>/dev/null 2>&1
if
   if
      [ -f /etc/dofsck ]
   then
      text="UNIX was not shut down properly after it was last used. Do you want to check the file systems ?"
      true
   elif
      [ -f /etc/dofsckalways ]
   then
      text="Do you want to check the file systems ?"
      true
   else
      text="The filing systems have not been checked recently. Do you want to check them."
      fname=`find /etc -name dofscktime -mtime +14 -print`
      [ "x$fname" = x/etc/dofscktime ]
   fi
then
	while :
	do
		yorn "File System Check" "$text"
		case $? in
			 0 )
				;;
	
			 1 )
				break
				;;
	
			* )
				continue
				;;
		esac
		(
			trap "echo Interrupt" 2
			nmimode 1
			/etc/fsck 
			trap "" 2
		) >/dev/console </dev/console 2>&1
		break
	done
fi
# initialise file system check file 
>/etc/dofsck
# set nmi mode to enable soft powerdown
/etc/nmimode 2
